{
  "name": "react-node-insim",
  "version": "0.3.3",
  "description": "React Node InSim",
  "author": "Martin Kapal <flamecze@gmail.com>",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "node": "./dist/cjs/index.js",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/simbroadcasts/react-node-insim.git"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc -b ./src/tsconfig.cjs.json ./src/tsconfig.esm.json ./src/tsconfig.types.json",
    "start": "tsx watch examples/index.tsx",
    "test": "run-s test:compile \"test:run {@}\" --",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:run": "vitest",
    "format": "run-s \"format:no-write --write\"",
    "format:no-write": "prettier \"./**/*.{js,ts,md,json,yml,yaml}\"",
    "format:check": "run-s \"format:no-write --check\"",
    "lint": "eslint \"./src/**/*\"",
    "lint:fix": "eslint \"./src/**/*\" --fix",
    "prepack": "run-s build"
  },
  "peerDependencies": {
    "node-insim": "^6.0.0",
    "react": ">=18",
    "react-devtools-core": "^7.0.1"
  },
  "peerDependenciesMeta": {
    "react-devtools-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/react-reconciler": "^0.33.0",
    "@welefen/grid-layout": "^1.1.0",
    "bunshi": "^2.2.0",
    "debug": "^4.4.3",
    "jotai": "^2.20.2",
    "ramda": "^0.32.0",
    "react-reconciler": "0.33.0",
    "yoga-layout-prebuilt": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/mitm": "^1.3.8",
    "@types/node": "^26.2.0",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "mitm": "^1.7.3",
    "node-insim": "^6.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
